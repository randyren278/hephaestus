[79.413083, "o", "\u001b[?2026h\u001b[?25l \u001b[1m\u001b[33mHEPHAESTUS \u001b[90m/ OPERATOR\u001b[39m\u001b[22m                                                      \u001b[90m\u25cf \u2014\u001b[39m\r\n\r\n \u001b[90m       \u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u001b[39m\r\n \u001b[90m     \u2584\u2588  \u2584\u2584  \u2584\u2584  \u2584\u2584  \u2584\u2584  \u2588\u2584\u001b[39m\r\n \u001b[33m    \u2588\u2580\u2588  \u2588\u2588  \u2588\u2588  \u2588\u2588  \u2588\u2588  \u2588\u2580\u2588\u001b[39m\r\n \u001b[90m   \u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u001b[39m\r\n \u001b[1m\u001b[37m  LOCAL CONTROL \u00b7 SCHEMA 1 \u00b7 OWNER SOCKET\u001b[39m\u001b[22m\r\n\r\n \u001b[90mOPERATOR ACTIONS\u001b[39m                             \u001b[90m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\r\n \u001b[33m\u203a Status  \u2039\u001b[39m                                  \u001b[90m\u2502\u001b[39m \u001b[90mCANONICAL STATUS\u001b[39m              \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Freeze\u001b[39m                                     \u001b[90m\u2502\u001b[39m Active runs  \u2014                \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Unfreeze\u001b[39m                                   \u001b[90m\u2502\u001b[39m Genomes      \u2014                \u001b[90m\ufffd"]
[79.413143, "o", "\ufffd\ufffd\u001b[39m\r\n \u001b[37m  Kill all active work\u001b[39m                       \u001b[90m\u2502\u001b[39m Ledger events \u2014               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Inspect job by ID\u001b[39m                          \u001b[90m\u2502\u001b[39m                               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Cancel job by ID\u001b[39m                           \u001b[90m\u2502\u001b[39m                               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Arena progress by ID\u001b[39m                       \u001b[90m\u2502\u001b[39m                               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Lineage and Champions\u001b[39m                      \u001b[90m\u2502\u001b[39m                               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Evidence & Costs\u001b[39m                           \u001b[90m\u2502\u001b[39m                               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Gene Bank\u001b[39m                                  \u001b[90m\u2502\u001b[39m                               \u001b[90m\u2502\u001b[39m\r\n \u001b[37m  Author Markdown agent\u001b[39m                      \u001b[90m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\r\n \u001b[90m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
[79.535696, "o", "\ufffd\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[39m\r\n \u001b[90m\u2502\u001b[39m \u001b[37mConnecting to the local control plane\u2026\u001b[39m                                     \u001b[90m\u2502\u001b[39m\r\n \u001b[90m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\r\n \u001b[90m\u2191\u2193/JK navigate \u00b7 Enter select \u00b7 Y/N confirm \u00b7 Q quit\u001b[39m\u001b[?2026l^[[B"]
[79.558902, "o", "\u001b[?2026h"]
